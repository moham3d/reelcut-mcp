# Optional stock B-roll API keys (can be added later)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Whisper CPU defaults (tiny, base, small, medium, large-v3-turbo)
REELCUT_WHISPER_MODEL=small
REELCUT_WHISPER_COMPUTE=int8
REELCUT_LANGUAGE=ar

# Optional central B-rolls folder shared across projects
REELCUT_BROLLS_DIR=

# Optional custom FFmpeg / FilmCraft / Arabic font path
REELCUT_FFMPEG_PATH=
REELCUT_FILMCRAFT_PATH=
REELCUT_RENDER_BACKEND=auto
REELCUT_COLOR_PRESET=none
REELCUT_FONT_PATH=

# --- Gemini: voiceover transcription + AI B-roll images ---
GEMINI_API_KEY=
REELCUT_GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
REELCUT_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
REELCUT_BROLL_PROVIDER=gemini_image
REELCUT_BROLL_BUDGET_USD=1.00
